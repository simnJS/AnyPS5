cmake_minimum_required(VERSION 3.25)

set(root "${WORK}/root")
set(pipeline "${root}/graphics/host_gpu/renderer/pipeline")
set(translator "${root}/graphics/shader/recompiler")
set(list_file "${WORK}/sources.txt")
set(failures 0)

function(write_tree cache_code translator_include)
    file(REMOVE_RECURSE "${root}")
    file(WRITE "${pipeline}/pipelineStoreFormat.h" "#pragma once\n")
    file(WRITE "${pipeline}/pipelineStoreTypes.h" "#pragma once\n")
    file(WRITE "${pipeline}/pipelineCache.cpp" "${cache_code}\n")
    file(WRITE "${translator}/Emitter.cpp"
         "#include \"common/assert.h\"\n#include \"graphics/host_gpu/regionDefinitions.h\"\n${translator_include}\n")
    file(WRITE "${list_file}" "${pipeline}/pipelineStoreFormat.h\n${pipeline}/pipelineStoreTypes.h\n${translator}/Emitter.cpp\n")
endfunction()

function(expect name cache_code translator_include message)
    write_tree("${cache_code}" "${translator_include}")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DLIST_FILE=${list_file}" "-DROOT=${root}" -P "${CHECK}"
                    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output)
    string(REGEX REPLACE "[ \t\r\n]+" " " output "${output}")
    if(message STREQUAL "")
        set(passed FALSE)
        if(result EQUAL 0)
            set(passed TRUE)
        endif()
    else()
        string(FIND "${output}" "${message}" found)
        set(passed FALSE)
        if(NOT result EQUAL 0 AND NOT found EQUAL -1)
            set(passed TRUE)
        endif()
    endif()
    if(NOT passed)
        message(SEND_ERROR "${name}: expected '${message}', got result ${result}: ${output}")
        math(EXPR count "${failures} + 1")
        set(failures ${count} PARENT_SCOPE)
    endif()
endfunction()

set(written "Shader program key written in an unstamped pipeline source")
set(input "Shader translation input written in an unstamped pipeline source")
set(included "The shader translator includes graphics/host_gpu/renderer/cache/textureCache.h")

expect(clean "void F(Key& key) { SetShaderLookupKey(key, params, input, false, switches); }" "" "")
expect(compared "bool F(const Key& a, const Key& b) { return a.static_state == b.static_state; }" "" "")
expect(read "uint32_t F(const Key& key) { return key.static_state.back(); }" "" "")
expect(pushed "void F(Key& key) { key.static_state.push_back(1u); }" "" "${written}")
expect(popped "void F(Key& key) { m_lookup_key.static_state.pop_back(); }" "" "${written}")
expect(assigned "void F(Key& key, const Key& other) { key.static_state = other.static_state; }" "" "${written}")
expect(element "void F(Key& key) { key.static_state[0] = 1u; }" "" "${written}")
expect(option "void F(Options& options) { options.rt_emulation = true; }" "" "${input}")
expect(pinned "" "#include \"graphics/host_gpu/renderer/cache/bufferCache.h\"" "")
expect(unpinned "" "#include \"graphics/host_gpu/renderer/cache/textureCache.h\"" "${included}")

if(failures GREATER 0)
    message(FATAL_ERROR "${failures} shader store source checks failed")
endif()
message(STATUS "kyty_shim_shader_store_sources: ok")
