#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer args_buf {
    uint args[];
};

layout(std430, binding = 1) writeonly buffer groups_buf {
    uint groups[];
};

layout(std430, binding = 2) writeonly buffer limit_buf {
    uint limit[];
};

layout(std430, binding = 3) buffer clamp_buf {
    uint clamped[];
};

layout(push_constant) uniform push_data {
    uvec3 local_size;
    uint  args_index;
    uint  groups_index;
    uint  limit_index;
    uint  shared_groups;
    uvec3 max_groups;
    uint  clamp_slot;
};

void main() {
    bool over = false;
    uvec3 counts;
    for (uint axis = 0u; axis < 3u; axis++) {
        const uint threads = args[args_index + axis];
        const uint size    = max(local_size[axis], 1u);
        uint count         = threads / size + ((threads % size) != 0u ? 1u : 0u);
        if (count > max_groups[axis]) {
            count = max_groups[axis];
            over  = true;
        }
        counts[axis] = count;
        limit[limit_index + axis]   = threads;
    }
    bool overflow = false;
    if (shared_groups != 0u && all(notEqual(counts, uvec3(0u)))) {
        overflow = counts.x > shared_groups / counts.y / counts.z;
    }
    for (uint axis = 0u; axis < 3u; axis++) {
        groups[groups_index + axis] = overflow ? 0u : counts[axis];
    }
    clamped[clamp_slot] = overflow ? 2u : uint(over);
}
