cmake_minimum_required(VERSION 3.25)

file(STRINGS "${LIST_FILE}" stamped ENCODING UTF-8)
set(pipeline "${ROOT}/graphics/host_gpu/renderer/pipeline")
file(GLOB_RECURSE candidates "${pipeline}/*.cpp" "${pipeline}/*.h" "${pipeline}/*.inc")
foreach(source IN LISTS candidates)
    if(NOT source IN_LIST stamped)
        file(READ "${source}" code)
        if(code MATCHES "(^|[^A-Za-z0-9_])(KYTY_IO_FIELDS|ShaderStoreFormat|IoStore[A-Za-z0-9_]*|DecodeShaderStoreFrame|SaveResourcePlan|LoadResourcePlan)([^A-Za-z0-9_]|$)"
           OR code MATCHES "m_store[ \t\r\n]*\\.[ \t\r\n]*Append[ \t\r\n]*\\(")
            message(FATAL_ERROR "Shader store serialization in an unstamped pipeline source: ${source}")
        endif()
        if(source STREQUAL "${pipeline}/pipelineCache.h")
            string(REPLACE "void StoreLayout(uint64_t key, const ShaderTessellationInputInfo& layout);" "" code "${code}")
        elseif(source STREQUAL "${pipeline}/pipelineManifestFormat.cpp")
            string(REGEX REPLACE "compute\\.lds_storage[ \t]*=[ \t]*false;" "" code "${code}")
        elseif(source STREQUAL "${pipeline}/pipelineManifest.cpp")
            string(REPLACE "m_tess_layouts.try_emplace(layout.first, layout.second);" "" code "${code}")
        endif()
        set(member "[ \t\r\n]*(\\.|->)[ \t\r\n]*")
        set(assignment "[ \t\r\n]*=[^=]")
        if(code MATCHES "${member}lds_storage${assignment}"
           OR code MATCHES "(^|[^A-Za-z0-9_])([A-Za-z0-9_]*options)${member}[A-Za-z0-9_]+(${member}[A-Za-z0-9_]+)*${assignment}")
            message(FATAL_ERROR "Shader translation input written in an unstamped pipeline source: ${source}")
        endif()
        if(source STREQUAL "${pipeline}/pipelineCache.cpp")
            string(REGEX REPLACE "input_info\\.(stage|host_subgroup_size)[ \t]*=[^=]" "" code "${code}")
        endif()
        if(code MATCHES "(^|[^A-Za-z0-9_])input_info${member}[A-Za-z0-9_]+(${member}[A-Za-z0-9_]+)*${assignment}")
            message(FATAL_ERROR "Shader translation input written in an unstamped pipeline source: ${source}")
        endif()
        if(code MATCHES "m_tess_layouts[ \t\r\n]*(\\.|\\[)"
           OR code MATCHES "(^|[^A-Za-z0-9_])(StoreLayout|AnalyzeTessellationPrograms)[ \t\r\n]*\\(")
            message(FATAL_ERROR "Shader store layout accessed in an unstamped pipeline source: ${source}")
        endif()
        if(code MATCHES "static_state${member}(push_back|emplace_back|pop_back|insert|assign|resize|clear|erase)[ \t\r\n]*\\("
           OR code MATCHES "static_state(\\[[^]]*\\])?${assignment}")
            message(FATAL_ERROR "Shader program key written in an unstamped pipeline source: ${source}")
        endif()
    endif()
endforeach()

set(translator "${ROOT}/graphics/shader")
set(translator_inputs
    "${ROOT}/graphics/guest_gpu/graphicsRun.h"
    "${ROOT}/graphics/guest_gpu/hardwareContext.h"
    "${ROOT}/graphics/host_gpu/regionDefinitions.h"
    "${ROOT}/graphics/host_gpu/renderer/cache/bufferCache.h"
    "${ROOT}/graphics/host_gpu/renderer/cache/guestHostView.h"
    "${ROOT}/graphics/host_gpu/renderer/renderContext.h"
    "${ROOT}/libs/errno.h")
foreach(source IN LISTS stamped)
    cmake_path(IS_PREFIX translator "${source}" NORMALIZE inside)
    if(NOT inside OR NOT EXISTS "${source}")
        continue()
    endif()
    cmake_path(GET source PARENT_PATH directory)
    file(STRINGS "${source}" includes REGEX "^[ \t]*#[ \t]*include[ \t]+\"")
    foreach(line IN LISTS includes)
        string(REGEX MATCH "\"([^\"]+)\"" unused "${line}")
        set(header "${CMAKE_MATCH_1}")
        if(EXISTS "${directory}/${header}")
            cmake_path(ABSOLUTE_PATH header BASE_DIRECTORY "${directory}" NORMALIZE OUTPUT_VARIABLE dependency)
        else()
            cmake_path(ABSOLUTE_PATH header BASE_DIRECTORY "${ROOT}" NORMALIZE OUTPUT_VARIABLE dependency)
        endif()
        cmake_path(IS_PREFIX translator "${dependency}" NORMALIZE local)
        cmake_path(IS_PREFIX ROOT "${dependency}" NORMALIZE project)
        if(local OR NOT project OR header MATCHES "^common/" OR dependency IN_LIST stamped
           OR dependency IN_LIST translator_inputs)
            continue()
        endif()
        message(FATAL_ERROR "The shader translator includes ${header}, which the shader store stamp does not cover: "
                            "pin what the translator reads from it in "
                            "graphics/shader/recompiler/backend/spirv/spirvEmitterHostLayout.cpp, then allow it in "
                            "check_shader_store_sources.cmake (${source})")
    endforeach()
endforeach()

set(schemas "${pipeline}/pipelineStoreFormat.h" "${pipeline}/pipelineStoreTypes.h")
while(schemas)
    list(POP_BACK schemas schema)
    if(schema IN_LIST checked)
        continue()
    endif()
    if(NOT schema IN_LIST stamped)
        message(FATAL_ERROR "Shader store schema missing from the stamp: ${schema}")
    endif()
    list(APPEND checked "${schema}")
    cmake_path(GET schema PARENT_PATH directory)
    file(STRINGS "${schema}" includes REGEX "^[ \t]*#[ \t]*include[ \t]+\"")
    foreach(line IN LISTS includes)
        string(REGEX MATCH "\"([^\"]+)\"" unused "${line}")
        set(header "${CMAKE_MATCH_1}")
        if(EXISTS "${directory}/${header}")
            cmake_path(ABSOLUTE_PATH header BASE_DIRECTORY "${directory}" NORMALIZE OUTPUT_VARIABLE dependency)
        else()
            cmake_path(ABSOLUTE_PATH header BASE_DIRECTORY "${ROOT}" NORMALIZE OUTPUT_VARIABLE dependency)
        endif()
        cmake_path(IS_PREFIX pipeline "${dependency}" NORMALIZE local)
        if(local)
            if(NOT dependency IN_LIST stamped)
                message(FATAL_ERROR "Shader store schema depends on an unstamped pipeline header: ${dependency}")
            endif()
            list(APPEND schemas "${dependency}")
        endif()
    endforeach()
endwhile()
