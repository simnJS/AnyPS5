#!/usr/bin/env python3
import argparse
import ctypes
import ctypes.util
import fcntl
import json
import mmap
import os
import re
import signal
import struct
import subprocess
import sys
import tempfile
from collections import Counter, defaultdict
from pathlib import Path


def run_guarded(command, work, log, payload=None, env=None):
    with tempfile.TemporaryFile(dir=work) as source:
        if payload:
            source.write(payload)
            source.seek(0)
        with subprocess.Popen(command, cwd=work, stdin=source, stdout=log, stderr=subprocess.STDOUT,
                              env=env, start_new_session=True) as proc:
            stopped = False
            try:
                while proc.poll() is None:
                    available = int(re.search(r'MemAvailable:\s+(\d+)', Path('/proc/meminfo').read_text())[1]) / 2**20
                    pause = available < (14 if stopped else 12)
                    if stopped != pause:
                        os.killpg(proc.pid, signal.SIGSTOP if pause else signal.SIGCONT)
                        stopped = pause
                    try:
                        proc.wait(timeout=1 if stopped else 0.2)
                    except subprocess.TimeoutExpired:
                        pass
            finally:
                if proc.poll() is None:
                    os.killpg(proc.pid, signal.SIGKILL)
            return proc.returncode


def read_recipes(path, selection):
    rows = defaultdict(set)
    with path.open() as stream:
        if stream.readline().strip() != 'kyty compute recipes 1':
            raise ValueError('unsupported recipe version')
        for line in stream:
            digest, *values = line.split()
            if len(values) != 7 or not re.fullmatch('[0-9a-f]{16}', digest):
                raise ValueError('invalid compute recipe')
            if selection is None or digest in selection:
                rows[int(digest, 16)].add(tuple(map(int, values)))
    return rows


def zstd_decoder():
    zstd = ctypes.CDLL(ctypes.util.find_library('zstd'))
    decompress = zstd.ZSTD_decompress
    decompress.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_void_p, ctypes.c_size_t]
    decompress.restype = ctypes.c_size_t
    return decompress


def inventory(args, binary):
    images = dict.fromkeys([*args.image, *args.auto_bindings, *(image for image, _ in args.bindings)])
    scan = subprocess.run([binary, '--inventory', args.assets, args.output, *images])
    if scan.returncode != 0:
        return scan.returncode
    tools = Path(__file__).resolve().parents[1]
    store = args.output / 'shaders.code'
    bindings = list(args.bindings)
    for number, image in enumerate(args.auto_bindings):
        mapping = args.output / f'elf-bindings-{number}.map'
        extract = subprocess.run([sys.executable, tools / 'kyty_elf_shader_bindings.py', image, store, '--output', mapping])
        if extract.returncode != 0:
            return extract.returncode
        bindings.append((image, mapping))
    command = [sys.executable, tools / 'compute_recipes.py', store, args.output / 'creation-records.bin',
               '--output', args.output / 'compute-recipes.txt']
    for image, mapping in bindings:
        command.extend(('--bindings', image, mapping))
    recipes = subprocess.run(command)
    if recipes.returncode != 0 or args.graphics_bundle is None:
        return recipes.returncode
    graphics = [sys.executable, tools / 'graphics-precache/bundle.py', args.graphics_bundle,
                '--output', args.output / 'graphics-passes.json']
    for image in dict.fromkeys(image for image, _ in bindings):
        graphics.extend(('--embedded-image', image))
    return subprocess.run(graphics).returncode


def existing_compute_programs(paths):
    known = set()
    for path in paths:
        with path.open() as stream:
            if stream.readline().strip() != '# kyty pipeline manifest v1':
                raise ValueError(f'unsupported pipeline manifest {path}')
            for line in stream:
                parts = line.split(maxsplit=3)
                if len(parts) < 3 or parts[0] != 'M' or parts[2] != 'cs':
                    continue
                match = re.search(r'(?:^|\s)code=([0-9a-f]{16})(?:\s|$)', line)
                if match is None:
                    raise ValueError(f'invalid compute module in {path}')
                known.add(match[1])
    return known


def reflected_texture_count(shader):
    if 'reflected_texture_count' in shader:
        count = shader['reflected_texture_count']
        if type(count) is not int or count < 0:
            raise ValueError('invalid reflected texture count')
        return count
    resources = shader.get('resources')
    if resources is None or any('kind' not in row or 'category' not in row for row in resources):
        return None
    return sum((row['kind'], row['category']) in ((2, 0), (12, 1)) for row in resources)


def select_compute_programs(args):
    inventory = json.loads(args.inventory.read_text())
    recipes = {f'{digest:016x}' for digest in read_recipes(args.recipes, None)}
    candidates = recipes - existing_compute_programs(args.existing)
    counts = defaultdict(set)
    for bundle in inventory['bundles']:
        for effect in bundle['effects']:
            for shader_pass in effect['passes']:
                shader = shader_pass['shaders'].get('cs')
                if shader is not None and shader['code'] in candidates:
                    counts[shader['code']].add(reflected_texture_count(shader))

    ranked = []
    for digest, declarations in counts.items():
        count = None if None in declarations else max(declarations)
        if not args.texture_free or count == 0:
            ranked.append((count is None, count or 0, digest))
    ranked.sort()
    selection = ''.join(f'{digest}\n' for _, _, digest in ranked[:args.limit])
    if args.output:
        with args.output.open('x', encoding='utf-8') as stream:
            stream.write(selection)
    else:
        sys.stdout.write(selection)
    return 0


def prepare(args, binary):
    selected = set(args.select.read_text().split()) if args.select else None
    recipes = read_recipes(args.recipes, selected)
    if not recipes or selected is not None and len(recipes) != len(selected):
        raise ValueError('missing selected recipes')
    root = Path(tempfile.mkdtemp(prefix='compute-', dir=binary.parent))
    print(root, flush=True)
    cache = root / '_PipelineCache'
    cache.mkdir()
    modules = set()
    counts = Counter()
    decompress = zstd_decoder()
    with args.store.open('rb') as stream, mmap.mmap(stream.fileno(), 0, access=mmap.ACCESS_READ) as data, \
         (cache / args.store.name).open('xb') as store, (root / 'results.tsv').open('w', buffering=1) as report:
        if data[:8] != struct.pack('<Q', 0x3145444F4359544B):
            raise ValueError('invalid code store')
        store.write(data[:8])
        offset = 8
        while recipes and offset < len(data):
            digest, words, compressed = struct.unpack_from('<QII', data, offset)
            start = offset + 16
            end = start + compressed
            if not words or not compressed or end > len(data):
                raise ValueError('invalid code record')
            offset = end
            variants = recipes.pop(digest, None)
            if variants is None:
                continue
            if words > 16 * 1024 * 1024:
                raise ValueError('oversized shader')
            code = ctypes.create_string_buffer(4 * words)
            if decompress(code, len(code), data[start:end], compressed) != len(code):
                raise ValueError('corrupt code')
            keep = False
            for index, recipe in enumerate(sorted(variants)):
                work = root / f'{digest:016x}-{index}'
                work.mkdir()
                with (work / 'translate.log').open('wb') as log:
                    payload = struct.pack('<Q8I', digest, *recipe, words) + code.raw
                    command = [binary, '--prepare-compute']
                    if args.signatures:
                        command.append(args.signatures.resolve(strict=True))
                    status = run_guarded(command, work, log, payload)
                counts[status] += 1
                print(f'{digest:016x}', index, status, sep='\t', file=report)
                if status == 0:
                    header, *lines = (work / 'compute.kpm').read_text().splitlines()
                    if header != '# kyty pipeline manifest v1' or not lines or not all(x.startswith('M ') for x in lines):
                        raise ValueError('invalid generated manifest')
                    modules.update(lines)
                    keep = True
            if keep:
                store.write(data[start-16:end])
    if recipes:
        raise ValueError(f'{len(recipes)} code records unavailable')
    manifest = cache / (args.store.stem + '.compute.kpm')
    manifest.write_text('# kyty pipeline manifest v1\n' + ''.join(line + '\n' for line in sorted(modules)))
    print(f'{len(modules)} modules, recipe status {dict(sorted(counts.items()))}')
    return int(not modules or (selected is not None and counts[65] != 0) or any(k not in (0, 65) for k in counts))


def excluded_device(policy_path, cache):
    policy = json.loads(policy_path.read_text())
    key = policy['device']
    if policy.get('version') != 1 or not re.fullmatch(r'KytyPC2:(?:[0-9a-f]{8}:){3}[0-9a-f]{32}', key):
        raise ValueError('invalid driver exclusion policy')
    denied = set(policy['programs'])
    if not all(re.fullmatch('[0-9a-f]{16}', h) for h in denied):
        raise ValueError('invalid program in driver exclusion policy')
    if not denied:
        return None
    for manifest in cache.glob('*.kpm'):
        with manifest.open() as rows:
            for row in rows:
                if row.startswith('M ') and ' cs ' in row:
                    match = re.search(r'\bcode=([0-9a-f]{16})\b', row)
                    if match and match[1] in denied:
                        return key
    header = bytes.fromhex(policy['shader_header'])
    if len(header) != 26:
        raise ValueError('invalid shader store header in driver exclusion policy')
    decompress = zstd_decoder()
    for store in cache.glob('*.shaders'):
        with store.open('rb') as stream:
            if stream.read(len(header)) != header:
                return key
            while frame := stream.read(16):
                compressed, size, _ = struct.unpack('<IIQ', frame)
                if not 0 < compressed < 256 * 1024**2 or not 13 <= size < 1024**3:
                    raise ValueError('invalid shader store frame')
                data = stream.read(compressed)
                raw = ctypes.create_string_buffer(size)
                if len(data) != compressed or decompress(raw, size, data, compressed) != size:
                    raise ValueError('unreadable shader store frame')
                kind, stage, program = struct.unpack_from('<BIQ', raw)
                if kind == 0 and stage == 3 and f'{program:016x}' in denied:
                    return key
    return None


def driver(args, binary):
    root = args.work.resolve(strict=True)
    if root.parent != binary.parent or not root.name.startswith(('compute-', 'graphics-')):
        raise ValueError('expected a private preparation directory')
    suffix = '.graphics.kpm' if root.name.startswith('graphics-') else '.compute.kpm'
    manifest, = (root / '_PipelineCache').glob('*' + suffix)
    title, version = manifest.name.removesuffix(suffix).rsplit('_', 1)
    cache = root / 'driver-cache'
    cache.mkdir(exist_ok=True)
    env = {k: v for k, v in os.environ.items() if not k.startswith(('KYTY_', '__GL_SHADER_DISK_CACHE', 'MESA_SHADER_CACHE'))}
    for key in ('KYTY_NATIVE_RT', 'KYTY_RT_STATS', 'KYTY_RT_ORACLE', 'KYTY_RT_RESULTS', 'KYTY_RT_EMULATION'):
        if key in os.environ:
            env[key] = os.environ[key]
    if args.four_job_marker:
        env['KYTY_PRECACHE_FOUR_JOB_MARKER'] = str(args.four_job_marker.resolve())
    workers = args.jobs + 2
    env.update(KYTY_PRECACHE_CPUS=str(2 * workers), KYTY_PRECACHE_DRIVER_JOBS=str(args.jobs),
               __GL_SHADER_DISK_CACHE_PATH=str(cache), MESA_SHADER_CACHE_DIR=str(cache), XDG_CACHE_HOME=str(cache))
    with args.gpu_lock.open('a') as lock, (root / 'driver.log').open('ab') as log:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        input_dirs = [manifest.parent]
        if env.get('KYTY_RT_STATS', '0') not in ('', '0') and env.get('KYTY_NATIVE_RT') != '0':
            profile = manifest.parent / 'rt-stats'
            profile.mkdir(exist_ok=True)
            for source in (manifest, manifest.parent / f'{title}_{version}.code'):
                target = profile / source.name
                if source.is_file():
                    try:
                        target.symlink_to(Path('..') / source.name)
                    except FileExistsError:
                        pass
            input_dirs.append(profile)
        command = [binary, root, title, version, '28800']
        if args.modules_only:
            command.append('--modules-only')
        else:
            policy = args.denylist or binary.parent / 'driver-deny.json'
            if args.denylist or policy.exists():
                for directory in input_dirs:
                    device = excluded_device(policy, directory)
                    if device:
                        command.extend(['--exclude-device', device])
                        break
        return run_guarded(command, root, log, env=env)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--binary', type=Path, default=Path(__file__).resolve().parents[2] / 'build-kyty/precache-tool/kyty_precache')
    commands = parser.add_subparsers(dest='command', required=True)
    scan = commands.add_parser('inventory', help='scan title files and derive compute recipes without starting the title')
    scan.add_argument('assets', type=Path)
    scan.add_argument('output', type=Path)
    scan.add_argument('--image', type=Path, action='append', default=[], help='scan an executable outside the assets directory')
    scan.add_argument('--auto-bindings', type=Path, action='append', default=[], metavar='RELINKED_ELF',
                      help='scan a locally relinked ELF and recover validated detached shader bindings')
    scan.add_argument('--bindings', type=Path, nargs=2, action='append', default=[], metavar=('IMAGE', 'MAP'),
                      help='resolve detached shader headers with verified creation argument file offsets')
    scan.add_argument('--graphics-bundle', type=Path, metavar='ASSET',
                      help='also export shipped shader stage pairs and render-state selections from a readable effect bundle')
    select = commands.add_parser('select', help='select shipped compute pass programs for prepare --select')
    select.add_argument('inventory', type=Path, help='shipped effect inventory JSON')
    select.add_argument('recipes', type=Path, help='validated compute creation recipes')
    select.add_argument('--existing', action='append', type=Path, default=[], metavar='MANIFEST',
                        help='exclude compute program identities present in this pipeline manifest')
    select.add_argument('--texture-free', action='store_true',
                        help='require reflection with no declared textures for every shipped use')
    select.add_argument('--limit', type=int, metavar='COUNT', help='limit the selection after ranking by declared textures')
    select.add_argument('--output', type=Path, metavar='FILE', help='write the selected program IDs to a new file')
    prep = commands.add_parser('prepare')
    prep.add_argument('store', type=Path)
    prep.add_argument('recipes', type=Path)
    prep.add_argument('--select', type=Path)
    prep.add_argument('--signatures', type=Path)
    graphics = commands.add_parser('prepare-graphics', help='prepare generic graphics modules and pipeline signatures')
    graphics.add_argument('store', type=Path)
    graphics.add_argument('signatures', type=Path)
    graphics.add_argument('output', type=Path, help='new graphics-* directory beside the driver tool')
    gpu = commands.add_parser('driver')
    gpu.add_argument('work', type=Path)
    gpu.add_argument('--modules-only', action='store_true')
    gpu.add_argument('--jobs', type=int, choices=range(1, 7), default=4,
                     help='maximum simultaneous Vulkan compute calls')
    gpu.add_argument('--four-job-marker', type=Path)
    gpu.add_argument('--denylist', type=Path)
    gpu.add_argument('--gpu-lock', type=Path, required=True)
    args = parser.parse_args()
    if args.command == 'select':
        if args.limit is not None and args.limit <= 0:
            select.error('--limit must be positive')
        try:
            return select_compute_programs(args)
        except (KeyError, OSError, ValueError) as error:
            select.error(str(error))
    if args.command == 'prepare-graphics':
        script = Path(__file__).resolve().parents[1] / 'graphics-precache/generic.py'
        return subprocess.run([sys.executable, script, args.store, args.signatures, args.output]).returncode
    binary = args.binary.resolve(strict=True)
    if args.command == 'inventory':
        return inventory(args, binary)
    if args.command == 'prepare':
        return prepare(args, binary)
    return driver(args, binary)


if __name__ == '__main__':
    raise SystemExit(main())
